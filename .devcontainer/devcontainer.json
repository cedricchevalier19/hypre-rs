{
  "name": "hypre-rs",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "RUST_VERSION": "1"
    }
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,

  // Keep build artifacts and the crate cache in named volumes: much faster than
  // a macOS bind mount, and it keeps Linux build output out of your host's target/.
  "mounts": [
    "source=hypre-rs-target,target=${containerWorkspaceFolder}/target,type=volume",
    "source=hypre-rs-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=hypre-rs-cargo-git,target=/usr/local/cargo/git,type=volume"
  ],
  "postCreateCommand": "sudo chown -R dev:dev target /usr/local/cargo/registry /usr/local/cargo/git && cargo fetch",

  // Needed for gdb/lldb inside the container.
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
